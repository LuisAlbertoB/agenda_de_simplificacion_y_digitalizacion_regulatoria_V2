{
	"info": {
		"_postman_id": "agenda-regulatoria-sprint1",
		"name": "Agenda de Simplificación y Digitalización Regulatoria — API Sprint 1",
		"description": "Colección de endpoints para probar la API REST del backend de Agenda Regulatoria (Sprint 1).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Obtener Token JWT (Login)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.access) {",
									"    pm.collectionVariables.set(\"access_token\", jsonData.access);",
									"    pm.environment.set(\"access_token\", jsonData.access);",
									"}",
									"if (jsonData.refresh) {",
									"    pm.collectionVariables.set(\"refresh_token\", jsonData.refresh);",
									"    pm.environment.set(\"refresh_token\", jsonData.refresh);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"correo_electronico\": \"admin@gob.mx\",\n    \"password\": \"Admin123456!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/token/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"token",
								""
							]
						}
					},
					"response": []
				},
				{
					"name": "Refrescar Token JWT",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refresh\": \"{{refresh_token}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/token/refresh/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"token",
								"refresh",
								""
							]
						}
					},
					"response": []
				}
			]
		},
